    public function index({{ indexRequest }} $request): JsonResponse
    {
        try {
            $records = $this->{{ modelVariable }}Service->paginate($request->validated());

            return response()->json([
                config('api-scaffold.envelope.keys.code', 'code') => 200,
                config('api-scaffold.envelope.keys.message', 'message') => config('api-scaffold.envelope.messages.index_success', 'Records retrieved successfully.'),
                config('api-scaffold.envelope.keys.data', 'data') => {{ resource }}::collection($records),
            ]);
        } catch (Throwable $throwable) {
            Log::error('Error retrieving records.', [
                'controller' => self::class,
                'method' => __METHOD__,
                'error' => $throwable->getMessage(),
            ]);

            return response()->json([
                config('api-scaffold.envelope.keys.code', 'code') => 500,
                config('api-scaffold.envelope.keys.message', 'message') => config('api-scaffold.envelope.messages.internal_error', 'Internal server error.'),
                config('api-scaffold.envelope.keys.data', 'data') => null,
            ], 500);
        }
    }

    public function show({{ model }} ${{ modelVariable }}): JsonResponse
    {
        try {
            return response()->json([
