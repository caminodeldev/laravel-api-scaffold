{
  "name": "caminodeldev/laravel-api-scaffold",
  "description": "Generate clean, secure and configurable Laravel APIs from database tables.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/caminodeldev/laravel-api-scaffold",
  "keywords": [
    "laravel",
    "api",
    "scaffold",
    "generator",
    "artisan",
    "eloquent",
    "form-request",
    "api-resource",
    "mysql",
    "security"
  ],
  "authors": [
    {
      "name": "Ricardo Jofré",
      "homepage": "https://github.com/rjofres",
      "role": "Creator and maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/caminodeldev/laravel-api-scaffold/issues",
    "source": "https://github.com/caminodeldev/laravel-api-scaffold"
  },
  "require": {
    "php": "^8.2",
    "illuminate/console": "^10.0|^11.0|^12.0",
    "illuminate/database": "^10.0|^11.0|^12.0",
    "illuminate/filesystem": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "CaminoDelDev\\LaravelApiScaffold\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CaminoDelDev\\LaravelApiScaffold\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CaminoDelDev\\LaravelApiScaffold\\ApiScaffoldServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "vendor/bin/phpunit --colors=always",
    "validate": "composer validate --strict"
  }
}
